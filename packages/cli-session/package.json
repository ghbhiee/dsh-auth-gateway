{
  "name": "dsh-plugin-cli-session",
  "version": "0.2.0",
  "description": "Resume-capable CLI runner for DeepSeek Harness: conversational text or machine-readable JSON from one plugin",
  "license": "MIT",
  "author": "guohongbo@outlook.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghbhiee/dsh-plugins.git",
    "directory": "packages/cli-session"
  },
  "homepage": "https://github.com/ghbhiee/dsh-plugins/tree/main/packages/cli-session#readme",
  "bugs": {
    "url": "https://github.com/ghbhiee/dsh-plugins/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./startup": "./lib/startup.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-cmdline": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis"
  ]
}
